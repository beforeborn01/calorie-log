<view class="login-page">
  <view class="brand">
    <view class="logo">🥗</view>
    <view class="title">食养记</view>
    <view class="subtitle">饮食 · 训练 · 一念一记</view>
  </view>

  <view class="card login-card">
    <view class="page-kicker">WECHAT MINI PROGRAM</view>
    <view class="headline">原生小程序版</view>
    <view class="muted small desc">不用内嵌 H5，直接使用微信登录和原生页面记录每日饮食与运动。</view>

    <button class="btn btn-primary login-btn" bindtap="onTapLogin" loading="{{loading}}" disabled="{{loading}}">
      微信一键登录
    </button>
    <button wx:if="{{hasToken}}" class="btn btn-ghost login-btn" bindtap="onTapClear">清除本地登录态</button>

    <view class="error" wx:if="{{errMsg}}">{{errMsg}}</view>
    <view class="muted tiny terms">记录与建议仅供个人参考，不构成医疗意见。</view>
  </view>
</view>
