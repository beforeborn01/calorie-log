.login-page { min-height: 100vh; box-sizing: border-box; padding: 120rpx 48rpx 80rpx; background: #F5F1E8; }
.brand { text-align: center; margin-bottom: 92rpx; }
.logo { font-size: 92rpx; }
.title { margin-top: 20rpx; font-size: 64rpx; font-weight: 800; color: #2C2620; letter-spacing: 8rpx; }
.subtitle { margin-top: 18rpx; font-size: 28rpx; color: #8A7F73; letter-spacing: 4rpx; }
.login-card { padding: 36rpx; }
.headline { font-size: 42rpx; font-weight: 800; margin: 8rpx 0 14rpx; }
.desc { line-height: 1.7; }
.login-btn { width: 100%; margin-top: 34rpx; }
.error { margin-top: 24rpx; color: #B0413E; font-size: 24rpx; text-align: center; }
.terms { margin-top: 28rpx; text-align: center; line-height: 1.6; }
