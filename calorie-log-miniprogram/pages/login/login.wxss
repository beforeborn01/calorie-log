.container {
  min-height: 100vh;
  background: #F5F1E8;
  padding: 120rpx 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand {
  margin-top: 80rpx;
  margin-bottom: 200rpx;
  text-align: center;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 40rpx;
}

.title {
  font-size: 64rpx;
  font-weight: 700;
  color: #2C2620;
  letter-spacing: 8rpx;
  font-family: 'Kalam', 'PingFang SC', sans-serif;
}

.subtitle {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #8A7F73;
  letter-spacing: 4rpx;
}

.cta {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #2C2620;
  color: #F5F1E8;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
}

.btn-primary[disabled] {
  background: #8A7F73;
  color: #F5F1E8;
}

.terms {
  font-size: 22rpx;
  color: #8A7F73;
}

.link {
  color: #2C2620;
  text-decoration: underline;
  margin: 0 6rpx;
}

.error {
  margin-top: 16rpx;
  color: #B0413E;
  font-size: 24rpx;
}
