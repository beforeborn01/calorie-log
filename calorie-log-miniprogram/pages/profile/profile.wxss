.avatar-img { width:100rpx; height:100rpx; border-radius:50rpx; flex-shrink:0; }
.avatar { width:100rpx; height:100rpx; border-radius:50rpx; background:#2C2620; color:#F5F1E8; display:flex; align-items:center; justify-content:center; font-size:42rpx; font-weight:800; }
.profile-stats { margin-top:28rpx; padding-top:22rpx; border-top:2rpx dashed rgba(44,38,32,.1); }
.menu-row { display:flex; align-items:center; gap:18rpx; margin-bottom:14rpx; }
.menu-title { font-size:30rpx; font-weight:800; margin-bottom:6rpx; }
