.range-card { margin-top:22rpx; }
.report-grid { margin:22rpx 0; }
.point-row { margin-bottom:12rpx; padding:20rpx; }

.chart-card { margin-bottom:18rpx; }
.bar-chart { display:flex; align-items:flex-end; gap:12rpx; min-height:210rpx; overflow-x:auto; padding-top:20rpx; }
.bar-col { min-width:58rpx; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; }
.bar { width:26rpx; min-height:16rpx; border-radius:999rpx 999rpx 4rpx 4rpx; background:#2C2620; }
.bar-value { font-size:20rpx; color:#8A7F73; margin-bottom:8rpx; }
.bar-date { font-size:20rpx; color:#B8AEA2; margin-top:8rpx; }
