<view class="container safe-bottom">
  <view class="page-kicker">SETTINGS</view>
  <view class="page-title">设置</view>

  <view class="card account-card">
    <view class="card-title">账号绑定</view>
    <view class="card-subtitle">当前手机号：{{profile && profile.phone ? profile.phone : '未绑定'}}</view>
    <view class="field bind-field"><text class="field-label">手机号</text><input class="input" type="number" value="{{phoneBind.phone}}" data-field="phone" bindinput="onBindInput" /></view>
    <view class="row gap">
      <input class="input flex-1" type="number" placeholder="验证码" value="{{phoneBind.verifyCode}}" data-field="verifyCode" bindinput="onBindInput" />
      <button class="btn" bindtap="onSendBindCode" loading="{{sendingCode}}">发码</button>
    </view>
    <button class="btn btn-primary" style="width:100%; margin-top:18rpx;" bindtap="onBindPhone" loading="{{bindingPhone}}">{{profile && profile.phone ? '换绑手机号' : '绑定手机号'}}</button>
  </view>

  <view class="card" wx:if="{{setting}}">
    <view class="card-title">饮食提醒</view>
    <view class="setting-row"><text>早餐</text><switch checked="{{setting.breakfastEnabled}}" data-field="breakfastEnabled" bindchange="onSwitch" /></view>
    <picker mode="time" value="{{setting.breakfastTime}}" data-field="breakfastTime" bindchange="onTime"><view class="picker-box time-box">早餐时间 {{setting.breakfastTime}}</view></picker>
    <view class="setting-row"><text>午餐</text><switch checked="{{setting.lunchEnabled}}" data-field="lunchEnabled" bindchange="onSwitch" /></view>
    <picker mode="time" value="{{setting.lunchTime}}" data-field="lunchTime" bindchange="onTime"><view class="picker-box time-box">午餐时间 {{setting.lunchTime}}</view></picker>
    <view class="setting-row"><text>晚餐</text><switch checked="{{setting.dinnerEnabled}}" data-field="dinnerEnabled" bindchange="onSwitch" /></view>
    <picker mode="time" value="{{setting.dinnerTime}}" data-field="dinnerTime" bindchange="onTime"><view class="picker-box time-box">晚餐时间 {{setting.dinnerTime}}</view></picker>
    <view class="field"><text class="field-label">频率</text><picker mode="selector" range="{{freqLabels}}" value="{{freqIndex}}" bindchange="onFreq"><view class="picker-box">{{freqLabels[freqIndex]}}</view></picker></view>
    <button class="btn btn-primary" style="width:100%;" bindtap="onSave" loading="{{saving}}">保存提醒设置</button>
  </view>

  <view class="section-title">修改密码</view>
  <view class="card">
    <view class="field"><text class="field-label">原密码</text><input class="input" password value="{{password.oldPassword}}" data-field="oldPassword" bindinput="onPwdInput" /></view>
    <view class="field"><text class="field-label">新密码</text><input class="input" password value="{{password.newPassword}}" data-field="newPassword" bindinput="onPwdInput" /></view>
    <button class="btn" style="width:100%;" bindtap="onChangePassword" loading="{{changing}}">修改密码</button>
  </view>
</view>
