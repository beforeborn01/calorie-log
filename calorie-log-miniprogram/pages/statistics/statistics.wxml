<view class="container safe-bottom">
  <view class="page-kicker">ANALYSIS</view>
  <view class="page-title">每日分析</view>
  <view class="card"><view class="row-between"><button class="btn btn-sm" bindtap="onPrevDay">前一天</button><picker mode="date" value="{{date}}" bindchange="onDateChange"><view class="date-picker"><view class="mono">{{date}}</view><view class="muted small">{{displayDate}}</view></view></picker><button class="btn btn-sm" bindtap="onNextDay">后一天</button></view></view>

  <view class="card empty-day" wx:if="{{noRecord}}">
    <view class="empty">这一天没有饮食记录，暂无分析</view>
  </view>

  <block wx:else>
  <view class="card banner" wx:if="{{inProgress}}">
    <view class="muted small">今日仍在进行中：评分与“摄入不足”类建议将在日终结算，下面是截至当前的情况。</view>
  </view>

  <view class="grid-2 card-grid">
    <view class="card" wx:for="{{cards}}" wx:key="label"><view class="stat-value mono">{{item.value}}</view><view class="stat-label">{{item.label}} {{item.unit}}</view></view>
  </view>

  <view class="card" wx:if="{{daily}}">
    <view class="card-title">状态</view>
    <view class="muted small status-hint">{{statusText}}</view>
    <view class="divider"></view>
    <view class="grid-3">
      <view><view class="stat-value mono">{{macro.protein}}</view><view class="stat-label">蛋白 g</view></view>
      <view><view class="stat-value mono">{{macro.carb}}</view><view class="stat-label">碳水 g</view></view>
      <view><view class="stat-value mono">{{macro.fat}}</view><view class="stat-label">脂肪 g</view></view>
    </view>
  </view>

  <block wx:if="{{scoreView}}">
    <view class="row-between section-title-row">
      <view class="section-title">评分拆解</view>
      <view class="help-link" data-key="all" bindtap="onShowScoreHelp">评分说明</view>
    </view>
    <view class="card" wx:if="{{!inProgress}}">
      <view class="score-row score-total"><text>总分</text><text class="mono">{{scoreView.total}} / 100</text></view>
      <view class="score-row" wx:for="{{scoreView.rows}}" wx:key="key" data-key="{{item.key}}" bindtap="onShowScoreHelp">
        <text>{{item.label}}<text class="help-q">?</text></text>
        <text class="mono">{{item.value}} / {{item.max}}</text>
      </view>
    </view>
    <view class="card" wx:else>
      <view class="muted small">评分将在日终结算。点右上「评分说明」了解每项怎么算。</view>
    </view>
  </block>

  <view class="section-title">建议</view>
  <view class="card" wx:if="{{visibleSuggestions.length === 0}}"><view class="empty">{{inProgress ? '目前没有需要注意的，继续保持' : '暂无建议'}}</view></view>
  <view class="card suggestion" wx:for="{{visibleSuggestions}}" wx:key="title">
    <view class="row-between"><view class="card-title">{{item.title}}</view><view class="tag sev-{{item.severity}}">{{item.sevLabel}}</view></view>
    <view class="muted small detail">{{item.detail}}</view>
    <view class="row-wrap" wx:if="{{item.recommendedFoods}}"><view class="tag" wx:for="{{item.recommendedFoods}}" wx:for-item="food" wx:key="*this">{{food}}</view></view>
  </view>
  </block>
</view>
