.date-picker { text-align:center; min-width:250rpx; }
.card-grid { margin:22rpx 0; }
.status-hint { margin-top:10rpx; line-height:1.7; }
.score-row { display:flex; justify-content:space-between; align-items:center; padding:18rpx 0; border-top:2rpx dashed rgba(44,38,32,.08); }
.score-row.score-total { font-weight:600; border-top:none; }
.progress-meta { margin: 4rpx 0 12rpx; line-height: 1.6; }
.suggestion { margin-bottom:18rpx; }
.detail { margin-top:12rpx; line-height:1.7; }

/* 进行中提示横幅 */
.banner { background:#FBF3E0; border-left:6rpx solid #C99A2E; }

/* 评分说明入口 */
.section-title-row { align-items:center; }
.help-link { font-size:24rpx; color:#8A7F73; padding:6rpx 0; }
.help-q { display:inline-block; margin-left:8rpx; width:30rpx; height:30rpx; line-height:30rpx; text-align:center; font-size:20rpx; color:#8A7F73; background:rgba(44,38,32,.06); border-radius:50%; }

/* 建议严重度标签配色 */
.tag.sev-info { background:rgba(44,38,32,.06); color:#6A6055; }
.tag.sev-warn { background:#FBF0D8; color:#B07D14; }
.tag.sev-critical { background:#F6DEDC; color:#B0413E; }
