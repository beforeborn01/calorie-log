.active-progress { margin-top:24rpx; }
.exercise-card { margin-top:22rpx; }
.set-row { display:grid; grid-template-columns: 60rpx 1fr 1fr 150rpx; gap:12rpx; align-items:center; padding:14rpx 0; border-top:2rpx dashed rgba(44,38,32,.08); }
.set-row.head { color:#8A7F73; font-size:24rpx; border-top:none; }
.mini-input { height:60rpx; border:2rpx solid rgba(44,38,32,.12); background:#FFFDF8; border-radius:14rpx; text-align:center; }
.action-bar { position: sticky; bottom: 18rpx; margin-top: 24rpx; }
